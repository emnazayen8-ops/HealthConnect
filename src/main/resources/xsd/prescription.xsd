<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <xs:element name="prescriptions">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="prescription" type="PrescriptionType"
                            minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="PrescriptionType">
        <xs:sequence>
            <xs:element name="patientId" type="xs:string"/>
            <xs:element name="medecin" type="xs:string"/>
            <xs:element name="consultationId" type="xs:string"/>
            <xs:element name="datePrescription" type="xs:date"/>
            <xs:element name="analysesDemandees" type="AnalysesType" minOccurs="0"/>
            <xs:element name="examensDemandes" type="ExamensType" minOccurs="0"/>
            <xs:element name="medicaments" type="MedicamentsType" minOccurs="0"/>
            <xs:element name="pharmacie" type="xs:string" minOccurs="0"/>
            <xs:element name="statut" type="StatutType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="AnalysesType">
        <xs:sequence>
            <xs:element name="analyse" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ExamensType">
        <xs:sequence>
            <xs:element name="examen" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MedicamentsType">
        <xs:sequence>
            <xs:element name="medicament" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="StatutType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="creee"/>
            <xs:enumeration value="envoyee"/>
            <xs:enumeration value="preparee"/>
            <xs:enumeration value="delivree"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>