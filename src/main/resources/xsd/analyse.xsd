<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <xs:element name="analyses">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="analyse" type="AnalyseType"
                            minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="AnalyseType">
        <xs:sequence>
            <xs:element name="patientId" type="xs:string"/>
            <xs:element name="prescriptionId" type="xs:string"/>
            <xs:element name="laboratoire" type="xs:string"/>
            <xs:element name="nomTest" type="xs:string"/>
            <xs:element name="dateAnalyse" type="xs:date" minOccurs="0"/>
            <xs:element name="valeur" type="xs:decimal" minOccurs="0"/>
            <xs:element name="unite" type="xs:string" minOccurs="0"/>
            <xs:element name="valeurNormale" type="xs:string" minOccurs="0"/>
            <xs:element name="critique" type="xs:boolean"/>
            <xs:element name="statut" type="StatutType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:simpleType name="StatutType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="demandee"/>
            <xs:enumeration value="realisee"/>
            <xs:enumeration value="validee"/>
            <xs:enumeration value="archivee"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>